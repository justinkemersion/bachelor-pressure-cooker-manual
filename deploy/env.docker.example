# Bachelor Cookbook production environment (content-only).
# Used with: docker compose --env-file .env.docker up --build -d
#
# Local working copy: deploy/.env.docker (gitignored). Never commit it.
# Sync to the server:
#   ./deploy/sync-env-remote.sh              # dry-run
#   ./deploy/sync-env-remote.sh --apply     # writes /srv/apps/bachelor-cookbook/.env.docker
#
# This phase is a public markdown reader. There are no Flux, Auth.js, or
# PostgREST variables. Do not invent them here — see docs/FUTURE_FLUX.md.

# --- Public branding (may be baked into the client bundle) ---
NEXT_PUBLIC_APP_NAME=Bachelor Cookbook
NEXT_PUBLIC_APP_URL=https://bachelor-cookbook.vsl-base.com

# --- Runtime: where the baked book lives in the image ---
BOOK_ROOT=/app/bachelor-cookbook-book
